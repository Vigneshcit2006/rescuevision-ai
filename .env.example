# RescueVision AI - example environment configuration (root / docker-compose)
#
# Copy this file to ".env" in the repo root to configure `docker compose up`.
# For running the backend directly with uvicorn (no Docker), copy
# backend/.env.example to backend/.env instead - pydantic-settings loads
# ".env" from the process's current working directory.
#
# NO REAL CREDENTIALS BELONG IN THIS FILE. Everything below is local-safe.

# --- Runtime environment -----------------------------------------------
ENVIRONMENT=local

# --- Backend selection ---------------------------------------------------
# "local" = no AWS required, data is written under ./backend/data
# "aws"   = uses the corresponding AWS service (see deployment/DEPLOYMENT_STEPS.md)
STORAGE_BACKEND=local
INCIDENT_BACKEND=local
NOTIFICATION_BACKEND=local

# --- AWS settings (only read when a *_BACKEND above is "aws") -----------
AWS_REGION=us-east-1
S3_BUCKET=
DYNAMODB_TABLE=rescuevision-incidents
SNS_TOPIC_ARN=
# Prefer an IAM instance role / task role in real deployments. Only set
# these for local testing against a real AWS account, and never commit them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Local storage paths (used when *_BACKEND=local) ---------------------
LOCAL_STORAGE_DIR=./data/evidence
LOCAL_DB_PATH=./data/incidents.db

# --- Application behavior -------------------------------------------------
DEFAULT_SCENARIO=fire_smoke
LOG_LEVEL=INFO

# --- Frontend build/runtime -----------------------------------------------
# Consumed by frontend/Dockerfile as a build ARG (Vite bakes this in at
# build time) and by `npm run dev` via frontend/.env.
VITE_API_BASE_URL=http://localhost:8000
