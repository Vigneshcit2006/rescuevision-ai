# RescueVision AI - backend environment configuration
#
# Copy to "backend/.env" (pydantic-settings' Settings class reads ".env"
# relative to the process working directory, which is `backend/` when you
# run `python -m uvicorn app.main:app` from inside that folder).
#
# NO REAL CREDENTIALS BELONG IN THIS FILE. Local mode (the default) needs
# zero AWS credentials.

ENVIRONMENT=local

# "local" or "aws" for each of these independently.
STORAGE_BACKEND=local
INCIDENT_BACKEND=local
NOTIFICATION_BACKEND=local

AWS_REGION=us-east-1
S3_BUCKET=
DYNAMODB_TABLE=rescuevision-incidents
SNS_TOPIC_ARN=

LOCAL_STORAGE_DIR=./data/evidence
LOCAL_DB_PATH=./data/incidents.db

DEFAULT_SCENARIO=fire_smoke
LOG_LEVEL=INFO
